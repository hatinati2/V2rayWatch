<Window x:Class="V2rayWatch.DesktopPrototype.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2rayWatch — Long-term history"
        Height="650" Width="980" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Foreground="{DynamicResource ThemeTextBrush}"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="HistoryCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="WindowTitle" Text="Long-term connection history" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextStrongBrush}"/>
        <TextBlock x:Name="ProfileNameText" Text="" FontSize="12" Margin="0,4,0,0"
                   Foreground="{DynamicResource ThemeMutedBrush}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="Period24Button" Content="Last 24 hours" Click="Period24_Click"/>
        <Button x:Name="Period7Button" Content="Last 7 days" Click="Period7_Click"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource HistoryCard}" Margin="0,0,5,0">
        <StackPanel>
          <TextBlock x:Name="SuccessRateLabel" Text="Successful checks" FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}"/>
          <TextBlock x:Name="SuccessRateValue" Text="—" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource ThemeGoodBrush}" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource HistoryCard}" Margin="5,0">
        <StackPanel>
          <TextBlock x:Name="TotalChecksLabel" Text="Total checks" FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}"/>
          <TextBlock x:Name="TotalChecksValue" Text="0" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource ThemeTextStrongBrush}" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource HistoryCard}" Margin="5,0">
        <StackPanel>
          <TextBlock x:Name="AverageDelayLabel" Text="Average delay" FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}"/>
          <TextBlock x:Name="AverageDelayValue" Text="—" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource ThemeAccentTextBrush}" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource HistoryCard}" Margin="5,0,0,0">
        <StackPanel>
          <TextBlock x:Name="FailedChecksLabel" Text="Failed checks" FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}"/>
          <TextBlock x:Name="FailedChecksValue" Text="0" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource ThemeBadBrush}" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock x:Name="TimelineTitle" Text="Connection timeline" FontSize="14" FontWeight="SemiBold"/>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="10" Height="10" CornerRadius="2" Background="#27A36A" Margin="10,0,4,0"/>
        <TextBlock x:Name="SuccessLegend" Text="Successful" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}"/>
        <Border Width="10" Height="10" CornerRadius="2" Background="#D9534F" Margin="10,0,4,0"/>
        <TextBlock x:Name="FailureLegend" Text="Failed" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}"/>
        <Border Width="10" Height="10" CornerRadius="2" Background="#777F8C" Margin="10,0,4,0"/>
        <TextBlock x:Name="NoDataLegend" Text="No data" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}"/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="3" Style="{StaticResource HistoryCard}" Padding="12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="TimelineHint" Text="Each bar represents one hour." FontSize="10"
                   Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TimelineItems">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="34" Margin="3,0" ToolTip="{Binding ToolTip}">
                  <TextBlock Text="{Binding Label}" FontSize="9" TextAlignment="Center"
                             Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,0,0,6"/>
                  <Grid Height="100" Background="#777F8C" ClipToBounds="True">
                    <StackPanel VerticalAlignment="Bottom">
                      <Border Height="{Binding FailureHeight}" Background="#D9534F"/>
                      <Border Height="{Binding SuccessHeight}" Background="#27A36A"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding TotalChecks}" FontSize="9" TextAlignment="Center"
                             Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource HistoryCard}" Margin="0,12,0,0" Padding="12">
      <StackPanel>
        <TextBlock x:Name="DetailsText" Text="More details" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock x:Name="DelayRangeText" Text="" FontSize="11" Margin="0,5,0,0"
                   Foreground="{DynamicResource ThemeMutedBrush}"/>
        <TextBlock x:Name="LongestFailureText" Text="" FontSize="11" Margin="0,4,0,0"
                   Foreground="{DynamicResource ThemeMutedBrush}"/>
        <TextBlock x:Name="DataScopeText" Text="" FontSize="10" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeMutedBrush}"/>
        <TextBlock x:Name="NoDataText" Text="" FontSize="11" Margin="0,5,0,0"
                   Foreground="{DynamicResource ThemeAccentTextBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
