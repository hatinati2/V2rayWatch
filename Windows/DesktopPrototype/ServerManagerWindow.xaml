<Window x:Class="V2rayWatch.DesktopPrototype.ServerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2rayWatch — Servers" Height="690" Width="1050" MinHeight="580" MinWidth="850"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FlowDirection="RightToLeft" FontFamily="Segoe UI">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="TitleText" Text="مدیریت سرورها" Foreground="#F4F8FF" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock x:Name="HintText" Text="لینک‌های VLESS، VMess، Trojan، Shadowsocks و Hysteria2 را وارد کنید." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel>
      <Button Content="×" Width="38" Height="34" DockPanel.Dock="Left" Click="Close_Click"/>
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="92"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="ImportLabel" Text="افزودن لینک یا Subscription" Foreground="#F4F8FF" FontWeight="SemiBold" FontSize="14"/>
        <TextBox x:Name="ImportTextBox" Grid.Row="1" Margin="0,10" Padding="10" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 Background="#0A1729" Foreground="#EAF2FF" BorderBrush="#29466E" CaretBrush="White"/>
        <DockPanel Grid.Row="2">
          <TextBlock x:Name="ImportStatus" Text="هر لینک را در یک خط قرار دهید. لینک Subscription کدگذاری‌شده نیز بررسی می‌شود." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="ClipboardButton" Content="چسباندن از Clipboard" Click="Clipboard_Click" Margin="0,0,8,0"/>
            <Button x:Name="ImportButton" Content="وارد کردن" Background="#087EBA" BorderBrush="{StaticResource AccentBrush}" Click="Import_Click"/>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
          <TextBlock x:Name="ProfilesTitle" Text="پروفایل‌های ذخیره‌شده" Foreground="#F4F8FF" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="CountText" Text="۰ سرور" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Left"/>
        </DockPanel>
        <DataGrid x:Name="ProfilesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" Background="#0A1729" Foreground="#EAF2FF"
                  RowBackground="#0D1C31" AlternatingRowBackground="#112440" BorderBrush="#29466E"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="پروتکل" Binding="{Binding Protocol}" Width="*"/>
            <DataGridTextColumn Header="میزبان" Binding="{Binding Host}" Width="2*"/>
            <DataGridTextColumn Header="پورت" Binding="{Binding Port}" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="StorageNote" Text="پروفایل‌ها به‌صورت محلی در پوشه کاربر ذخیره می‌شوند؛ فایل حاوی اطلاعات اتصال است." Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="RemoveButton" Content="حذف انتخاب‌شده" Click="Remove_Click" IsEnabled="False" Margin="0,0,8,0"/>
        <Button x:Name="SelectButton" Content="انتخاب سرور" Click="Select_Click" IsEnabled="False" Background="#087EBA" BorderBrush="{StaticResource AccentBrush}"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
