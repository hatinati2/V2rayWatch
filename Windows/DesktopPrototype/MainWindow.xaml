<Window x:Class="V2rayWatch.DesktopPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2rayWatch — Link Monitor" Height="860" Width="1460" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#071426" Foreground="#EAF2FF"
        FlowDirection="RightToLeft" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0D2038"/><SolidColorBrush x:Key="Panel2" Color="#102844"/>
    <SolidColorBrush x:Key="Line" Color="#1D3A5C"/><SolidColorBrush x:Key="Muted" Color="#93A9C5"/>
    <SolidColorBrush x:Key="Accent" Color="#12B8C5"/><SolidColorBrush x:Key="Good" Color="#45D483"/>
    <SolidColorBrush x:Key="Bad" Color="#F16B75"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#193B5D"/><Setter Property="Foreground" Value="#EAF2FF"/>
      <Setter Property="BorderBrush" Value="#315273"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#245178"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#087EBA"/><Setter Property="BorderBrush" Value="#08C7D8"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="15"/>
    </Style>
    <Style x:Key="DarkTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="#071426"/><Setter Property="Foreground" Value="#EAF2FF"/>
      <Setter Property="BorderBrush" Value="#315273"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#173451"/><Setter Property="Foreground" Value="#C6D7EA"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,8"/>
      <Setter Property="BorderBrush" Value="#284867"/>
    </Style>
    <Style x:Key="GridCell" TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="#173451"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#155176"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="GridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="#0D2038"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="MinHeight" Value="36"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#155176"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#12304B"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0C1A2E" CornerRadius="13" BorderBrush="#1D3555" BorderThickness="1">
      <DockPanel Margin="17,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19" Background="#123D59" BorderBrush="#12B8C5" BorderThickness="1" Margin="0,0,10,0">
            <TextBlock Text="◷" Foreground="#69E6DF" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="V2rayWatch" FontSize="20" FontWeight="Bold" Foreground="#F4F8FF"/>
            <TextBlock x:Name="HeaderSubtitle" Text="پایش و تست واقعی لینک‌های پروکسی" FontSize="10" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button x:Name="LanguageButton" Content="FA / EN" Click="LanguageButton_Click"/>
          <Button x:Name="AddLinksButton" Content="افزودن لینک" Click="AddLinks_Click"/>
          <Button x:Name="AddSubscriptionButton" Content="افزودن Subscription" Click="AddSubscription_Click"/>
          <Button x:Name="TestAllButton" Style="{StaticResource PrimaryButton}" Content="تست همه لینک‌ها" Click="TestAll_Click"/>
          <Button x:Name="MonitorButton" Content="شروع پایش خودکار" Click="Monitor_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,0">
            <StackPanel><TextBlock x:Name="TotalLabel" Text="کل پروفایل‌ها" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TotalCount" Text="۰" Foreground="#F4F8FF" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0">
            <StackPanel><TextBlock x:Name="ConnectedLabel" Text="متصل" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ConnectedCount" Text="۰" Foreground="{StaticResource Good}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="5,0">
            <StackPanel><TextBlock x:Name="DisconnectedLabel" Text="قطع" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DisconnectedCount" Text="۰" Foreground="{StaticResource Bad}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="3" Style="{StaticResource Card}" Margin="5,0,0,0">
            <StackPanel><TextBlock x:Name="SubscriptionCountLabel" Text="اشتراک‌ها" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="SubscriptionCount" Text="۰" Foreground="#69E6DF" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="ProfilesTitle" Text="پروفایل‌ها و نتیجهٔ تست" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProfilesHint" Text="هر پروفایل مستقل از پراکسی و تنظیمات شبکهٔ ویندوز تست می‌شود." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBox x:Name="SearchInput" Width="180" Style="{StaticResource DarkTextBox}" VerticalContentAlignment="Center"
                         TextChanged="SearchInput_TextChanged" ToolTip="جست‌وجوی نام، میزبان یا پروتکل"/>
                <Button x:Name="TestSelectedButton" Content="تست انتخاب‌شده" Click="TestSelected_Click"/>
                <Button x:Name="RemoveSelectedButton" Content="حذف" Click="RemoveSelected_Click"/>
              </StackPanel>
            </DockPanel>

            <DataGrid x:Name="ProfilesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" Background="#0A1729" Foreground="#EAF2FF"
                      RowBackground="#0D2038" AlternatingRowBackground="#102844" BorderBrush="#1D3A5C"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12"
                      ColumnHeaderStyle="{StaticResource GridHeader}" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}"
                      SelectionChanged="ProfilesGrid_SelectionChanged" RowDetailsVisibilityMode="Visible">
              <DataGrid.Columns>
                <DataGridTextColumn Header="نام پروفایل" Binding="{Binding Name}" Width="1.7*"/>
                <DataGridTextColumn Header="پروتکل" Binding="{Binding Protocol}" Width="*"/>
                <DataGridTextColumn Header="میزبان" Binding="{Binding Endpoint}" Width="1.6*"/>
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusDisplay}" Width="*"/>
                <DataGridTextColumn Header="تأخیر" Binding="{Binding DelayDisplay}" Width="85"/>
                <DataGridTextColumn Header="آخرین بررسی" Binding="{Binding LastCheckedDisplay}" Width="95"/>
              </DataGrid.Columns>
              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <Grid Margin="9,3,9,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="۲۰ بررسی خودکار اخیر" Foreground="#93A9C5" FontSize="10" VerticalAlignment="Center"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding UptimeHistory}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="20"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="9" Margin="1" CornerRadius="2">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#718096"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding}" Value="G"><Setter Property="Background" Value="#45D483"/></DataTrigger>
                                  <DataTrigger Binding="{Binding}" Value="R"><Setter Property="Background" Value="#F16B75"/></DataTrigger>
                                  <DataTrigger Binding="{Binding}" Value="N"><Setter Property="Background" Value="#718096"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="0,10,0,0">
              <TextBlock x:Name="GridFooter" Text="تست دستی، تاریخچهٔ پایش خودکار را تغییر نمی‌دهد." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="ImportClipboardButton" Content="چسباندن از Clipboard" Click="ImportClipboard_Click"/>
                <Button x:Name="ImportFileButton" Content="ورود از فایل" Click="ImportFile_Click"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock x:Name="MonitorSettingsTitle" Text="تنظیمات پایش" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="IntervalLabel" Text="فاصلهٔ بررسی" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/>
              <ComboBox x:Name="IntervalCombo" SelectedValuePath="Tag" Background="#071426" Foreground="#EAF2FF" BorderBrush="#315273" Padding="6">
                <ComboBoxItem Content="۲۰ ثانیه" Tag="20"/><ComboBoxItem Content="۳۰ ثانیه" Tag="30"/>
                <ComboBoxItem Content="۶۰ ثانیه" Tag="60"/><ComboBoxItem Content="۱۲۰ ثانیه" Tag="120"/>
              </ComboBox>
              <TextBlock x:Name="ThresholdLabel" Text="تعداد خطای متوالی تا قطع" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4"/>
              <ComboBox x:Name="ThresholdCombo" SelectedValuePath="Tag" Background="#071426" Foreground="#EAF2FF" BorderBrush="#315273" Padding="6">
                <ComboBoxItem Content="۱ خطا" Tag="1"/><ComboBoxItem Content="۲ خطا" Tag="2"/><ComboBoxItem Content="۳ خطا" Tag="3"/>
                <ComboBoxItem Content="۴ خطا" Tag="4"/><ComboBoxItem Content="۵ خطا" Tag="5"/>
              </ComboBox>
              <TextBlock x:Name="TimeoutLabel" Text="مهلت هر تست (ثانیه)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4"/>
              <TextBox x:Name="TimeoutInput" Style="{StaticResource DarkTextBox}" FlowDirection="LeftToRight" Text="15"/>
              <TextBlock x:Name="PrimaryUrlLabel" Text="آدرس تست اصلی" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4"/>
              <TextBox x:Name="PrimaryUrlInput" Style="{StaticResource DarkTextBox}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
              <TextBlock x:Name="FallbackUrlLabel" Text="آدرس جایگزین" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4"/>
              <TextBox x:Name="FallbackUrlInput" Style="{StaticResource DarkTextBox}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
              <Button x:Name="SaveSettingsButton" Content="ذخیره تنظیمات" Click="SaveSettings_Click" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="SubscriptionsTitle" Text="مدیریت اشتراک‌ها" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="SubscriptionsHint" Text="منابع Subscription ذخیره می‌شوند و هرکدام را می‌توان جداگانه به‌روزرسانی کرد." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <DataGrid x:Name="SubscriptionsGrid" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                        SelectionMode="Single" SelectionUnit="FullRow" Background="#071426" Foreground="#EAF2FF"
                        RowBackground="#0D2038" AlternatingRowBackground="#102844" BorderBrush="#1D3A5C"
                        GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="11"
                        ColumnHeaderStyle="{StaticResource GridHeader}" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                  <DataGridTextColumn Header="تعداد" Binding="{Binding ProfileCount}" Width="55"/>
                  <DataGridTextColumn Header="آخرین دریافت" Binding="{Binding LastUpdatedDisplay}" Width="125"/>
                </DataGrid.Columns>
              </DataGrid>
              <Button x:Name="UpdateSubscriptionButton" Content="به‌روزرسانی اشتراک انتخاب‌شده" Click="UpdateSubscription_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
              <Button x:Name="UpdateAllSubscriptionsButton" Content="به‌روزرسانی همه اشتراک‌ها" Click="UpdateAllSubscriptions_Click" HorizontalAlignment="Stretch"/>
              <Button x:Name="RemoveSubscriptionButton" Content="حذف منبع اشتراک" Click="RemoveSubscription_Click" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="#0C1A2E" CornerRadius="8" Padding="10,0" BorderBrush="#1D3555" BorderThickness="1">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="آماده؛ تست هر لینک مستقل از VPN و پراکسی سیستم انجام می‌شود." Foreground="#93A9C5" FontSize="10" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Text="V2rayWatch • Windows Link Monitor" Foreground="#69E6DF" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Left"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
