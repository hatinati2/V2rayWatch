<Window x:Class="V2rayWatch.DesktopPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2rayWatch — Link Monitor" Height="860" Width="1460" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeWindowBgBrush}" Foreground="{DynamicResource ThemeTextBrush}"
        FlowDirection="RightToLeft" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>




    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryButtonBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="15"/>
    </Style>
    <Style x:Key="DarkTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource ThemeWindowBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style x:Key="NumericTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
      <Setter Property="Height" Value="42"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Consolas"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}"/><Setter Property="Background" Value="{DynamicResource ThemeGridBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/><Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemeGridHeaderTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineBrush}"/>
    </Style>
    <Style x:Key="GridCell" TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeGridHeaderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeGridSelectedBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="GridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="MinHeight" Value="36"/><Setter Property="ToolTip" Value="{Binding ImportWarning}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeGridSelectedBrush}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeGridHoverBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBgBrush}" CornerRadius="13" BorderBrush="{DynamicResource ThemeLineBrush}" BorderThickness="1">
      <DockPanel Margin="17,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource ThemeLogoBgBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" Margin="0,0,10,0">
            <Image x:Name="LogoImage" Width="34" Height="34" Stretch="Uniform"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="V2rayWatch" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextStrongBrush}"/>
            <TextBlock x:Name="HeaderSubtitle" Text="پایش و تست واقعی لینک‌های پروکسی" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button x:Name="LanguageButton" Content="FA / EN" Click="LanguageButton_Click"/>
          <Button x:Name="ThemeButton" Content="تم روشن" Click="ThemeButton_Click"/>
          <Button x:Name="AddLinksButton" Content="افزودن لینک" Click="AddLinks_Click"/>
          <Button x:Name="AddSubscriptionButton" Content="افزودن Subscription" Click="AddSubscription_Click"/>
          <Button x:Name="TestAllButton" Style="{StaticResource PrimaryButton}" Content="تست همه لینک‌ها" Click="TestAll_Click"/>
          <Button x:Name="MonitorButton" Content="شروع پایش" Click="Monitor_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,0">
            <StackPanel><TextBlock x:Name="TotalLabel" Text="کل پروفایل‌ها" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/><TextBlock x:Name="TotalCount" Text="۰" Foreground="{DynamicResource ThemeTextStrongBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0">
            <StackPanel><TextBlock x:Name="ConnectedLabel" Text="متصل" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/><TextBlock x:Name="ConnectedCount" Text="۰" Foreground="{DynamicResource ThemeGoodBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="5,0">
            <StackPanel><TextBlock x:Name="DisconnectedLabel" Text="قطع" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/><TextBlock x:Name="DisconnectedCount" Text="۰" Foreground="{DynamicResource ThemeBadBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="3" Style="{StaticResource Card}" Margin="5,0,0,0">
            <StackPanel><TextBlock x:Name="SubscriptionCountLabel" Text="اشتراک‌ها" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/><TextBlock x:Name="SubscriptionCount" Text="۰" Foreground="{DynamicResource ThemeAccentTextBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="ProfilesTitle" Text="پروفایل‌ها و نتیجهٔ تست" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProfilesHint" Text="هر پروفایل مستقل از پراکسی و تنظیمات شبکهٔ ویندوز تست می‌شود." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBox x:Name="SearchInput" Width="180" Style="{StaticResource DarkTextBox}" VerticalContentAlignment="Center"
                         TextChanged="SearchInput_TextChanged" ToolTip="جست‌وجوی نام، میزبان یا پروتکل"/>
                <Button x:Name="TestSelectedButton" Content="تست انتخاب‌شده" Click="TestSelected_Click"/>
                <Button x:Name="LongTermHistoryButton" Content="تاریخچهٔ بلندمدت" Click="LongTermHistory_Click" IsEnabled="False"/>
                <Button x:Name="RemoveSelectedButton" Content="حذف" Click="RemoveSelected_Click"/>
                <Button x:Name="DeleteAllProfilesButton" Content="حذف همه لینک‌ها" Click="RemoveAllProfiles_Click"/>
              </StackPanel>
            </DockPanel>

            <DataGrid x:Name="ProfilesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" Background="{DynamicResource ThemeGridBgBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                      RowBackground="{DynamicResource ThemePanelBrush}" AlternatingRowBackground="{DynamicResource ThemePanelAltBrush}" BorderBrush="{DynamicResource ThemeLineBrush}"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12"
                      ColumnHeaderStyle="{StaticResource GridHeader}" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}"
                      SelectionChanged="ProfilesGrid_SelectionChanged" RowDetailsVisibilityMode="Visible">
              <DataGrid.Columns>
                <DataGridTextColumn Header="نام پروفایل" Binding="{Binding Name}" Width="1.7*"/>
                <DataGridTextColumn Header="پروتکل" Binding="{Binding Protocol}" Width="*"/>
                <DataGridTextColumn Header="میزبان" Binding="{Binding Endpoint}" Width="1.6*"/>
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusDisplay}" Width="*"/>
                <DataGridTextColumn Header="تأخیر" Binding="{Binding DelayDisplay}" Width="85"/>
                <DataGridTextColumn Header="آخرین بررسی" Binding="{Binding LastCheckedDisplay}" Width="95"/>
              </DataGrid.Columns>
              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <Grid Margin="9,3,9,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RecentChecksLabel}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding UptimeHistory}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="50"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="9" Margin="1" CornerRadius="2">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ThemeHistoryNeutralBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding}" Value="G"><Setter Property="Background" Value="{DynamicResource ThemeGoodBrush}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding}" Value="R"><Setter Property="Background" Value="{DynamicResource ThemeBadBrush}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding}" Value="N"><Setter Property="Background" Value="{DynamicResource ThemeHistoryNeutralBrush}"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="0,10,0,0">
              <TextBlock x:Name="GridFooter" Text="تست دستی، تاریخچهٔ پایش خودکار را تغییر نمی‌دهد." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="ImportClipboardButton" Content="چسباندن از Clipboard" Click="ImportClipboard_Click"/>
                <Button x:Name="ImportFileButton" Content="ورود از فایل" Click="ImportFile_Click"/>
                <Button x:Name="ExportBackupButton" Content="پشتیبان‌گیری" Click="ExportBackup_Click"/>
                <Button x:Name="ImportBackupButton" Content="بازیابی پشتیبان" Click="ImportBackup_Click"/>
                <Button x:Name="ShowQrButton" Content="نمایش QR" Click="ShowSelectedQr_Click" IsEnabled="False"/>
                <Button x:Name="ScanQrImageButton" Content="خواندن QR از تصویر" Click="ScanQrImage_Click"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock x:Name="MonitorSettingsTitle" Text="تنظیمات پایش" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="IntervalLabel" Text="فاصله بین هر تست (ثانیه)" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,5"/>
              <TextBox x:Name="IntervalInput" Style="{StaticResource NumericTextBox}" FlowDirection="LeftToRight" Text="20" MaxLength="4" ToolTip="1 تا 9999 ثانیه" PreviewTextInput="NumericOnly_PreviewTextInput"/>
              <TextBlock x:Name="ThresholdLabel" Text="تعداد شکست متوالی پیش از هشدار" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,5"/>
              <TextBox x:Name="ThresholdInput" Style="{StaticResource NumericTextBox}" FlowDirection="LeftToRight" Text="2" MaxLength="4" ToolTip="1 تا 9999 شکست" PreviewTextInput="NumericOnly_PreviewTextInput"/>
              <TextBlock x:Name="TimeoutLabel" Text="مهلت هر تست (ثانیه)" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" Margin="0,10,0,4"/>
              <TextBox x:Name="TimeoutInput" Style="{StaticResource DarkTextBox}" FlowDirection="LeftToRight" Text="15"/>
              <TextBlock x:Name="PrimaryUrlLabel" Text="آدرس تست اصلی" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" Margin="0,10,0,4"/>
              <TextBox x:Name="PrimaryUrlInput" Style="{StaticResource DarkTextBox}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
              <TextBlock x:Name="FallbackUrlLabel" Text="آدرس جایگزین" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" Margin="0,10,0,4"/>
              <TextBox x:Name="FallbackUrlInput" Style="{StaticResource DarkTextBox}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
              <CheckBox x:Name="NotifyDisconnectInput" Content="هشدار هنگام قطع لینک" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,0"/>
              <CheckBox x:Name="NotifyRecoveryInput" Content="هشدار هنگام بازیابی لینک" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,5,0,0"/>
              <Button x:Name="SaveSettingsButton" Content="ذخیره تنظیمات" Click="SaveSettings_Click" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="SubscriptionsTitle" Text="مدیریت اشتراک‌ها" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="SubscriptionsHint" Text="منابع Subscription ذخیره می‌شوند و هرکدام را می‌توان جداگانه به‌روزرسانی کرد." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <DataGrid x:Name="SubscriptionsGrid" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                        SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SubscriptionsGrid_SelectionChanged"
                        Background="{DynamicResource ThemeWindowBgBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                        RowBackground="{DynamicResource ThemePanelBrush}" AlternatingRowBackground="{DynamicResource ThemePanelAltBrush}" BorderBrush="{DynamicResource ThemeLineBrush}"
                        GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="11"
                        ColumnHeaderStyle="{StaticResource GridHeader}" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                  <DataGridTextColumn Header="تعداد" Binding="{Binding ProfileCount}" Width="55"/>
                  <DataGridTextColumn Header="آخرین دریافت" Binding="{Binding LastUpdatedDisplay}" Width="125"/>
                  <DataGridTemplateColumn Header="عملیات" Width="84">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="{Binding RemoveActionDisplay}" Tag="{Binding}" Click="RemoveSubscriptionRow_Click"
                                Padding="4,3" Margin="1" MinWidth="70" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" Focusable="True" ToolTip="{Binding RemoveActionDisplay}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <Button x:Name="UpdateSubscriptionButton" Content="به‌روزرسانی اشتراک انتخاب‌شده" Click="UpdateSubscription_Click" IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
              <Button x:Name="UpdateAllSubscriptionsButton" Content="به‌روزرسانی همه اشتراک‌ها" Click="UpdateAllSubscriptions_Click" HorizontalAlignment="Stretch"/>
              <Button x:Name="RemoveSubscriptionButton" Content="حذف منبع اشتراک" Click="RemoveSubscription_Click" IsEnabled="False" HorizontalAlignment="Stretch"/>
              <Button x:Name="RemoveAllSubscriptionsButton" Content="حذف همه اشتراک‌ها و لینک‌هایشان" Click="RemoveAllSubscriptions_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource ThemeHeaderBgBrush}" CornerRadius="8" Padding="10,0" BorderBrush="{DynamicResource ThemeLineBrush}" BorderThickness="1">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="آماده؛ تست هر لینک مستقل از VPN و پراکسی سیستم انجام می‌شود." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Text="V2rayWatch • Windows Link Monitor" Foreground="{DynamicResource ThemeAccentTextBrush}" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Left"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
