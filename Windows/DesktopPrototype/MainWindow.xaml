<Window x:Class="V2rayWatch.DesktopPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2rayWatch" Height="850" Width="1440" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FlowDirection="RightToLeft" FontFamily="Segoe UI">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0C1A2E" CornerRadius="14,14,0,0" BorderBrush="#1D3555" BorderThickness="1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" Margin="0,0,10,0"/>
          <TextBlock Text="V2rayWatch" Foreground="#F5F8FF" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="  •  WINDOWS CLIENT" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LanguageButton" Content="FA  |  EN" Click="LanguageButton_Click" Padding="12,6"/>
          <TextBlock Text="   ─   □   ×" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,12,12,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Text="داشبورد" Foreground="#F4F8FF" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,14"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="205">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="ConnectionState" Text="قطع اتصال" Foreground="#DDE8FA" FontSize="14"/>
                <TextBlock Text="  /  DISCONNECTED" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Width="104" Height="104" CornerRadius="52" BorderBrush="#1C5470" BorderThickness="2" Background="#102A43" VerticalAlignment="Center">
                  <TextBlock Text="◉" Foreground="{StaticResource AccentBrush}" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                  <TextBlock Text="آماده برای اتصال" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="SemiBold"/>
                  <TextBlock Text="برای شروع، یک سرور انتخاب کنید" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,8,0,0"/>
                  <TextBlock Text="تأخیر: —" Foreground="{StaticResource GreenBrush}" FontSize="15" Margin="0,12,0,0"/>
                </StackPanel>
              </Grid>
              <Button Grid.Row="2" Content="اتصال (در مرحله اتصال موتور فعال می‌شود)" IsEnabled="False" Background="#087EBA" BorderBrush="#08C7D8" HorizontalAlignment="Stretch"/>
            </Grid>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,6">
              <StackPanel><TextBlock Text="سرعت دانلود" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="— MB/s" Foreground="#F4F8FF" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="بدون داده زنده" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,6">
              <StackPanel><TextBlock Text="سرعت آپلود" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="— MB/s" Foreground="#F4F8FF" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="بدون داده زنده" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,6,6,0">
              <StackPanel><TextBlock Text="مدت اتصال" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="—" Foreground="#F4F8FF" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="6,6,0,0">
              <StackPanel><TextBlock Text="حجم مصرفی" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="—" Foreground="#F4F8FF" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="105"/></Grid.RowDefinitions>
              <DockPanel><TextBlock Text="نمودار زنده ترافیک" Foreground="#F4F8FF" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="پس از اتصال موتور نمایش داده می‌شود" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Left"/></DockPanel>
              <Border Grid.Row="1" Background="#0B192B" CornerRadius="9" Margin="0,12,0,0" BorderBrush="#1A3452" BorderThickness="1">
                <TextBlock Text="داده‌ای برای نمایش وجود ندارد" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
              <StackPanel>
                <DockPanel><TextBlock Text="سرورهای من" Foreground="#F4F8FF" FontSize="16" FontWeight="SemiBold"/><Button Content="افزودن سرور +" DockPanel.Dock="Left" IsEnabled="False" Padding="10,5"/></DockPanel>
                <TextBlock Text="هنوز سروری اضافه نشده است" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,30,0,8"/>
                <TextBlock Text="از بخش سرورها می‌توانید لینک یا QR وارد کنید." Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
              <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel><TextBlock Text="System Proxy" Foreground="#F4F8FF" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="غیرفعال — اتصال موتور هنوز انجام نشده" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="حالت TUN" Foreground="#F4F8FF" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="غیرفعال — نیازمند اتصال موتور و دسترسی مدیر" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Column="1" Background="#0D1B30" CornerRadius="14" BorderBrush="#1D3555" BorderThickness="1" Margin="0,12,0,12" Padding="12">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="8,8,8,22">
            <TextBlock Text="V2rayWatch" Foreground="#F4F8FF" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="مدیریت اتصال امن" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel>
            <Button Content="⌂   داشبورد" Style="{StaticResource NavButton}" Background="#075E91" Click="Dashboard_Click"/>
            <Button Content="▤   سرورها" Style="{StaticResource NavButton}" Click="Servers_Click"/>
            <Button Content="▱   اشتراک‌ها" Style="{StaticResource NavButton}" Click="Subscriptions_Click"/>
            <Button Content="⌘   مسیریابی" Style="{StaticResource NavButton}" Click="Routing_Click"/>
            <Button Content="▥   گزارش‌ها" Style="{StaticResource NavButton}" Click="Logs_Click"/>
            <Button Content="⚙   تنظیمات" Style="{StaticResource NavButton}" Click="Settings_Click"/>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Background="#122844" CornerRadius="10" Padding="10" Margin="0,15,0,0">
            <StackPanel><TextBlock Text="نسخه پیش‌نمایش رابط" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="UI prototype • موتور متصل نیست" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#0C1A2E" CornerRadius="0,0,14,14" BorderBrush="#1D3555" BorderThickness="1">
      <DockPanel Margin="14,0">
        <TextBlock Text="●" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="  رابط کاربری آماده است؛ موتور پروکسی هنوز متصل نشده" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Text="V2rayWatch • Windows" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
